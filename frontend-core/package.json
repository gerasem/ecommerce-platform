{
  "name": "ecommerce-frontend-core",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "npx cross-env PORT=3001 nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "gql:gen": "graphql-codegen --config codegen.yml"
  },
  "dependencies": {
    "@dargmuesli/nuxt-cookie-control": "9.1.29",
    "@nuxt/hints": "1.0.3",
    "@nuxt/scripts": "1.2.1",
    "@nuxt/ui": "4.8.2",
    "@nuxtjs/i18n": "10.2.4",
    "@pinia/nuxt": "0.11.3",
    "@stripe/stripe-js": "9.8.0",
    "gsap": "3.15.0",
    "isomorphic-dompurify": "3.16.0",
    "nuxt": "4.4.8",
    "photoswipe": "5.4.4",
    "pinia": "3.0.4",
    "swiper": "12.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.3.1",
    "@graphql-codegen/typescript": "5.0.10",
    "@graphql-codegen/typescript-operations": "5.1.0",
    "@iconify-json/bi": "1.2.7",
    "@nuxt/eslint": "1.16.0",
    "@nuxtjs/sitemap": "8.2.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "graphql": "16.14.2",
    "prettier": "3.8.4",
    "sass": "1.100.0",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.4"
  }
}
