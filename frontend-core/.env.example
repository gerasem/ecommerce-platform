# Payload URLs. The private URL is used by SSR/server routes; the public URL is
# sent to the browser.
NUXT_PAYLOAD_URL=http://localhost:3000
NUXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# Public site identity and canonical URL.
NUXT_PUBLIC_SITE_NAME="Aura Store"
NUXT_PUBLIC_PRICING_MODE=natural
NUXT_SITE_URL=http://localhost:3001

# Captcha Provider ('google' or 'yandex')
NUXT_PUBLIC_CAPTCHA_PROVIDER=google

# Google reCAPTCHA v3 (Invisible)
# Get keys from https://www.google.com/recaptcha/admin
# IMPORTANT: Select "reCAPTCHA v3" when creating the keys.
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=your-v3-site-key
# Keep RECAPTCHA_SECRET_KEY in the backend environment only.

# Yandex SmartCaptcha (Invisible)
# Get keys from https://yandex.cloud/ru/services/smartcaptcha
NUXT_PUBLIC_YANDEX_CAPTCHA_SITE_KEY=your-yandex-site-key
# Keep YANDEX_CAPTCHA_SECRET_KEY in the backend environment only.

# Stripe Public Key
NUXT_PUBLIC_STRIPE_KEY=pk_test_...

# Google Analytics
# NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-...

# Payload API Key (server-only, for server-to-server calls like coupon validation)
# Generate this in Payload Admin → Users → your admin user → API Key tab
NUXT_PAYLOAD_API_KEY=

NUXT_PUBLIC_ENABLE_STRIPE=false
NUXT_PUBLIC_ENABLE_COUPONS=false
NUXT_PUBLIC_ENABLE_REFERRALS=false
NUXT_PUBLIC_ENABLE_NEWS=false
NUXT_PUBLIC_ENABLE_RELATED_PRODUCTS=true

# Cookie Banner Style ('eu' or 'ru')
NUXT_PUBLIC_COOKIE_BANNER_STYLE=eu
