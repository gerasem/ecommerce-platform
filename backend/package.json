{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Multi-tenant Headless Ecommerce Backend (Payload CMS 3 + PostgreSQL)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "dev:prod": "npm run build && npm run start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_LOCALES=en,de,fr,ru PAYLOAD_DEFAULT_LOCALE=en payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "npm ci",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "switch": "node scripts/switch.mjs",
    "switch:status": "node scripts/switch.mjs status",
    "switch:restore": "node scripts/switch.mjs restore",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation node --import dotenv/config --import tsx scripts/seed-base.ts",
    "stripe-webhooks": "stripe listen --forward-to localhost:3000/api/stripe/webhooks",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:money": "node --import tsx --test src/lib/money.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@payloadcms/admin-bar": "3.86.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-nodemailer": "3.86.0",
    "@payloadcms/live-preview-react": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/plugin-ecommerce": "3.86.0",
    "@payloadcms/plugin-form-builder": "3.86.0",
    "@payloadcms/plugin-seo": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/translations": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@radix-ui/react-accordion": "1.2.11",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@stripe/react-stripe-js": "^3",
    "@stripe/stripe-js": "^4.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^8.2.0",
    "embla-carousel-auto-scroll": "^8.1.5",
    "embla-carousel-react": "^8.5.2",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "jsonwebtoken": "9.0.1",
    "lucide-react": "^0.477.0",
    "next": "16.2.11",
    "next-themes": "0.4.6",
    "node-cron": "^4.6.0",
    "payload": "3.86.0",
    "pdfmake": "^0.3.11",
    "prism-react-renderer": "^2.3.1",
    "qs-esm": "^7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.54.1",
    "sharp": "0.35.3",
    "slugify": "^1.6.9",
    "sonner": "^1.7.2",
    "stripe": "18.5.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2.11",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "4.0.12",
    "@tailwindcss/typography": "^0.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "22.5.4",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "@vercel/git-hooks": "^1.0.0",
    "@vitejs/plugin-react": "4.5.2",
    "cheerio": "^1.2.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.12",
    "tsx": "4.22.4",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "overrides": {
    "next@16.2.11": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
