PAYLOAD_SECRET=your-payload-secret
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/ecommerce

COMPANY_NAME="Aura Store"
TWITTER_CREATOR="@yourtwitter"
TWITTER_SITE="https://yourwebsite.com"
SITE_NAME="Aura Store"
NEXT_PUBLIC_SITE_NAME="Aura Store"

# Deployment-level features. Restart the backend after changing these values.
ENABLE_COUPONS=false
ENABLE_REFERRALS=false
ENABLE_NEWS=false
ENABLE_MULTI_CURRENCY=false
ENABLE_INVOICES=false
ENABLE_INVENTORY=false
ENABLE_VARIANTS=false
ENABLE_RELATED_PRODUCTS=true
ENABLE_STRIPE=false

# Payment provider: none, stripe or kustom. When omitted, ENABLE_STRIPE is used
# as a backwards-compatible fallback.
PAYMENT_PROVIDER=none

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=your-draft-secret

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_...

# Kustom Checkout credentials must only be used by the backend. A complete
# integration is required before selecting PAYMENT_PROVIDER=kustom in production.
KUSTOM_ENVIRONMENT=playground
KUSTOM_API_URL=https://api.playground.kustom.co
KUSTOM_USERNAME=
KUSTOM_PASSWORD=
KUSTOM_PURCHASE_COUNTRY=DE
KUSTOM_PURCHASE_CURRENCY=EUR

# Email Configuration
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=info@example.com
# SMTP_FROM_NAME=Example Shop

# Server-side CAPTCHA verification for public forms and registration.
# Provider must match the frontend NUXT_PUBLIC_CAPTCHA_PROVIDER value.
CAPTCHA_PROVIDER=google
RECAPTCHA_SECRET_KEY=your-v3-secret-key
# YANDEX_CAPTCHA_SECRET_KEY=your-yandex-secret-key

# CORS & CSRF Origins (comma separated list of domains)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

# Localization (comma separated list of locales)
PAYLOAD_LOCALES=en,de,ru
PAYLOAD_DEFAULT_LOCALE=en

# Optional per-store upload directories. Defaults remain public/media and
# public/svg-media for backwards compatibility.
# MEDIA_DIR=.data/example/media
# SVG_MEDIA_DIR=.data/example/svg-media

# Frontend Deploy Hook URL
FRONTEND_DEPLOY_HOOK_URL=""

# SMTP Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME="Aura Store"
